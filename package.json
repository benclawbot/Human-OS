{
  "name":"human-os",
  "version":"4.0.0",
  "private":true,
  "type":"module",
  "description":"A minimal local-first personal recursive improvement PWA — no AI or backend",
  "engines":{"node":">=20"},
  "scripts":{
    "dev":"node scripts/serve.mjs",
    "start":"node scripts/serve.mjs",

# Provide these ONLY through your deployment's encrypted environment settings.
APP_PASSWORD=replace-with-a-unique-passphrase-of-12-or-more-characters
SESSION_SECRET=replace-with-at-least-32-random-characters
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Vercel uses a connected PRIVATE Blob store, with OIDC or BLOB_READ_WRITE_TOKEN.
# Local development defaults to SQLite.
